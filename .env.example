# Traccoon PayAgent environment variables
# Copy to .env.local and fill in. Never commit .env.local.
# Everything here is server-side only. Do not prefix secrets with NEXT_PUBLIC_.

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
# Public base URL. Local: http://localhost:3000. Production: your Vercel URL.
# PayPal webhooks and return URLs are built from this.
APP_URL=http://localhost:3000
# Used to resolve "next Friday" etc. Do not change for the demo.
APP_TIMEZONE=Asia/Manila
# Login password for the deployed app. Leave blank locally to run without login
# (the header then shows "Test data only"). Set it on Vercel before deploying.
APP_PASSWORD=

# ---------------------------------------------------------------------------
# Database (Neon Postgres) - Phase 0, required
# ---------------------------------------------------------------------------
# Neon dashboard > Connection details > pooled connection string.
# Looks like: postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# ---------------------------------------------------------------------------
# AI models - Phase 1 (Meta hackathon), required
# ---------------------------------------------------------------------------
# Which provider the agent uses: "meta" (Meta Model API) or "baseten" (open weights).
MODEL_PROVIDER=meta

# Meta Model API key (the account with the $150 hackathon credits).
META_API_KEY=
# API base URL from the Meta Model API quickstart docs.
META_API_BASE_URL=https://api.meta.ai/v1
# Exact model IDs from the Meta Model API model list.
# Text/agent model (Muse Spark series):
META_TEXT_MODEL=muse-spark-1.3
# Vision model for chat screenshots (Muse Spark, if it accepts images):
META_VISION_MODEL=muse-spark-1.3
# Speech-to-text model for voice notes (Muse Voice Transcribe). Optional, P1.
META_TRANSCRIBE_MODEL=muse-voice-transcribe-1.0

# Baseten (open-weight prize). Optional, P1. Leave blank if credits haven't arrived.
BASETEN_API_KEY=
# OpenAI-compatible endpoint. Confirm against the Baseten quickstart.
BASETEN_BASE_URL=https://inference.baseten.co/v1
# The guide says to use this exact ID, NOT meta-models/muse-spark-open.
BASETEN_MODEL=meta-models/muse-spark-open-1026

# ---------------------------------------------------------------------------
# PayPal Sandbox - Phase 2, fill in on 5 Nov
# ---------------------------------------------------------------------------
# developer.paypal.com > Apps & Credentials > Sandbox > your app.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Created after registering ${APP_URL}/api/webhooks/paypal in the PayPal dashboard.
PAYPAL_WEBHOOK_ID=
# PHP if the 5 Nov spike shows it works in sandbox, otherwise USD.
PAYPAL_CURRENCY=PHP

# ---------------------------------------------------------------------------
# Stellar testnet + Noir contracts - Phase 3, fill in on 6 Nov
# ---------------------------------------------------------------------------
STELLAR_NETWORK=testnet
# Soroban RPC endpoint for testnet.
STELLAR_RPC_URL=
# Secret key of a testnet account funded via Friendbot. Testnet only.
STELLAR_AGENT_SECRET=
# Current contract IDs from the noirx402/noir repo (they were redeployed 1 Nov; re-check on 6 Nov).
NOIR_AGENT_REGISTRY_ID=
NOIR_PAYMENT_ESCROW_ID=
NOIR_DEVICE_REGISTRY_ID=
# Asset used for testnet payments (e.g. native XLM or a test asset contract ID).
STELLAR_ASSET=
